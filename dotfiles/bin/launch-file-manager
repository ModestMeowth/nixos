#!/usr/bin/env bash

file_manager=""
for candidate in nautilus dolphin; do
    if command -v "$candidate"; then
       file_manager="$candidate"
       break
    fi
done

if command -v uwsm &>/dev/null; then
    if uwsm check may-start; then
        exec setsid uwsm-app -- "$file_manager" "$@"
        exit 0
    fi
fi

exec setsid -- "$file_manager" "$@"
